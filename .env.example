# Учётные данные ClickHouse THEATRE_RU.
# Одна пара используется для sv1-bfa-ch, mv1-bfa-ch и mv2-bfa-ch.
# Список серверов и WORKERS задаются в src/main.py; порт 8123, база BookingFormAnalyticsV2.
# Скопируйте файл в .env и замените значения на реальные.
THEATRE_LOGIN_RU=your_login
THEATRE_PASS_RU=your_password

# THEATRE_ASIA (port 8123)
THEATRE_LOGIN_ASIA=
THEATRE_PASS_ASIA=
